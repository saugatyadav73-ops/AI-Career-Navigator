# ---- Server ----
PORT=5000
JWT_SECRET=change_this_to_a_long_random_string
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# ---- AI providers (configure at least one; all optional) ----
# Order in which providers are tried (automatic failover)
AI_PROVIDER_ORDER=openai,gemini,huggingface
AI_TIMEOUT_MS=45000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- Email verification (optional; if empty, accounts are auto-verified in dev) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Roles (comma separated emails; these accounts become admin / faculty automatically) ----
ADMIN_EMAILS=
FACULTY_EMAILS=

# ---- Google login (optional). Create an OAuth "Web" client at console.cloud.google.com and paste the client ID ----
GOOGLE_CLIENT_ID=

# ---- Security / operations (all optional) ----
NODE_ENV=development
# Set to true to require login for the older AI endpoints too (mentor, resume, jobs/match, quiz, ...)
REQUIRE_AUTH_FOR_AI=false
RATE_LIMIT_MAX=600
AI_RATE_LIMIT_MAX=120
# Behind a proxy (Render/Railway) set TRUST_PROXY=1 so rate limits use the real client IP
TRUST_PROXY=
# Database backups: folder, how many to keep, automatic interval in hours (0 = manual only)
BACKUP_DIR=
BACKUP_KEEP=7
BACKUP_INTERVAL_HOURS=0
# Optional: raises the GitHub API rate limit for the GitHub analyzer
GITHUB_TOKEN=
