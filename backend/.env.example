# ---- Server ----
PORT=5000
JWT_SECRET=change_this_to_a_long_random_string
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# ---- AI providers (configure at least one; all optional) ----
# Order in which providers are tried (automatic failover)
AI_PROVIDER_ORDER=openai,gemini,huggingface
AI_TIMEOUT_MS=45000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- Email verification (optional; if empty, accounts are auto-verified in dev) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
